    },
    {
      "name": "a member keeps their signed copy of an archived form: an Archived tab of their own opens it",
      "members": {
        "parent": "admin",
        "kid": "child"
      },
      "steps": [
        {
          "action": "seedRaw",
          "sql": "INSERT INTO app_forms__forms (id, title, description, status, audience_kind, audience_member_ids, requires_signature, signature_text, created_by, created_at, updated_at, opened_at, closed_at) VALUES (?, ?, '', 'archived', 'everyone', '[]', 0, '', ?, '2026-01-01T00:00:00Z', '2026-01-01T00:00:00Z', '2026-01-02T00:00:00Z', '2026-01-05T00:00:00Z')",
          "params": [
            "ui-af1",
            "Last year's trip consent",
            "{{parent}}"
          ]
        },
        {
          "action": "seedRaw",
          "sql": "INSERT INTO app_forms__questions (id, form_id, position, type, label, help, required, options, body, link_url) VALUES (?, ?, 0, 'yesno', ?, '', 1, '[]', '', '')",
          "params": [
            "ui-aq1",
            "ui-af1",
            "May your child attend?"
          ]
        },
        {
          "action": "seedRaw",
          "sql": "INSERT INTO app_forms__submissions (id, form_id, member_id, status, answers, signed_name, signed_at, signed_text, terms_hash, submitted_at, created_at, updated_at) VALUES (?, ?, ?, 'submitted', ?, '', NULL, '', '', '2026-01-03T00:00:00Z', '2026-01-03T00:00:00Z', '2026-01-03T00:00:00Z')",
          "params": [
            "ui-as1",
            "ui-af1",
            "{{kid}}",
            "{\"ui-aq1\":\"yes\"}"
          ]
        },
        {
          "action": "open",
          "as": "kid"
        },
        {
          "action": "click",
          "as": "kid",
          "selector": "[data-testid=\"tab-archived\"]"
        },
        {
          "action": "click",
          "as": "kid",
          "selector": "[data-testid=\"form-card\"][data-form-id=\"ui-af1\"]"
        },
        {
          "action": "click",
          "as": "kid",
          "selector": "[data-testid=\"view-mine\"]"
        },
        {
          "action": "waitFor",
          "as": "kid",
          "selector": "[data-testid=\"submission-modal\"]"
        },
        {
          "action": "expectText",
          "as": "kid",
          "text": "May your child attend?",
          "selector": "[data-testid=\"submission-modal\"]"
        }
      ]
    }
  ]
}
