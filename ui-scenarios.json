          "sql": "INSERT INTO app_forms__forms (id, title, description, status, audience_kind, audience_member_ids, requires_signature, signature_text, created_by, created_at, updated_at, opened_at) VALUES (?, ?, '', 'open', 'everyone', '[]', 0, '', ?, '2026-01-01T00:00:00Z', '2026-01-01T00:00:00Z', '2026-01-02T00:00:00Z')",
          "params": [
            "ui-rf1",
            "Field trip consent",
            "{{steward}}"
          ]
        },
        {
          "action": "seedRaw",
          "sql": "INSERT INTO app_forms__questions (id, form_id, position, type, label, help, required, options, body, link_url) VALUES (?, ?, 0, 'yesno', ?, '', 1, '[]', '', '')",
          "params": [
            "ui-rq1",
            "ui-rf1",
            "May your child attend?"
          ]
        },
        {
          "action": "open",
          "as": "family"
