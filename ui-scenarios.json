          "selector": "[data-testid=\"new-form\"]",
          "count": 0
        },
        {
          "action": "click",
          "as": "family",
          "selector": "[data-testid=\"form-card\"][data-form-id=\"ui-rf1\"]"
        },
        {
          "action": "expectVisible",
          "as": "family",
          "selector": "[data-testid=\"fill-form\"]"
        },
        {
          "action": "expectCount",
          "as": "family",
          "selector": "[data-testid=\"manage\"]",
          "count": 0
        },
        {
          "action": "open",
          "as": "steward"
        },
        {
          "action": "expectVisible",
          "as": "steward",
          "selector": "[data-testid=\"new-form\"]"
        },
        {
          "action": "click",
          "as": "steward",
          "selector": "[data-testid=\"form-card\"][data-form-id=\"ui-rf1\"]"
        },
        {
          "action": "expectVisible",
          "as": "steward",
          "selector": "[data-testid=\"manage\"]"
